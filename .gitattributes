# Benchmark logs and reports are documentation, not source code
results/*.log linguist-documentation
results/*.txt linguist-documentation
results/*.md  linguist-documentation
patches/*.md  linguist-documentation

# Force language detection AND inclusion in stats
# (examples/ is in linguist vendor list, so explicit detectable=true is required)
*.rs              linguist-language=Rust   linguist-detectable=true
*.cpp             linguist-language=C++    linguist-detectable=true
*.hpp             linguist-language=C++    linguist-detectable=true
examples/**/*.rs  linguist-language=Rust   linguist-detectable=true
examples/**/*.cpp linguist-language=C++    linguist-detectable=true
main.rs           linguist-language=Rust   linguist-detectable=true
main.cpp          linguist-language=C++    linguist-detectable=true
